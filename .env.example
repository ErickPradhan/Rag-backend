# Copy this file to ".env" and fill in your own key.
# Default setup uses Google Gemini (free key: https://aistudio.google.com/apikey)
LLM_API_KEY=put-your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Redis (chat memory). Local docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Qdrant: leave QDRANT_URL empty to store vectors in a local folder.
# Or paste a Qdrant Cloud URL + key.
QDRANT_URL=
QDRANT_API_KEY=

# Database for metadata + bookings (SQLite file by default)
DATABASE_URL=sqlite:///./app.db
